
# ==========================================
# CSPM Project - .gitignore
# ==========================================

# Terraform local directories
.terraform/

# Terraform state files (sensitive data)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Terraform variable files
*.tfvars
*.tfvars.json

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan
tfplan
planout

# Terraform crash logs
crash.log
crash.*.log

# Environment files (potential secrets)
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# AWS local credentials
.aws/
credentials

# Editor and OS temporary files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.pyc

# Keep Terraform provider dependency lock file
!.terraform.lock.hcl
